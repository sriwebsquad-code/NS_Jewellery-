{
  "expo": {
    "name": "NS Jewellery",
    "slug": "ns-jewellery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gold icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#D4AF37",
    "splash": {
      "image": "./assets/gold icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nsjewellery.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.anonymous.nsjewellery",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive_foreground.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "androidStatusBar": {
      "hidden": true
    },
    "androidNavigationBar": {
      "visible": "sticky-immersive"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "246bb4d2-78a9-4bf3-8377-58bf356e3bd4"
      }
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 21,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ]
    ]
  }
}