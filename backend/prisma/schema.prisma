generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum PlanType {
  AMOUNT
  GOLD
  SILVER
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  MISSED
}

enum MetalType {
  GOLD
  SILVER
}

enum TransactionType {
  BUY
  SELL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  mpin      String?  // Hashed 4-digit MPIN
  name      String?
  email     String?  @unique
  address   String?
  city      String?
  state     String?
  pincode   String?
  role      Role     @default(CUSTOMER)
  
  aadharNumber String?   @unique
  kycStatus    String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  
  userPlans           UserPlan[]
  installments        Installment[]
  digitalLocker       DigitalLocker?
  digitalTransactions DigitalTransaction[]
  wishlistItems       Wishlist[]
  notifications       Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JewelleryCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  image     String?
  items     JewelleryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JewelleryItem {
  id              String   @id @default(uuid())
  categoryId      String
  category        JewelleryCategory @relation(fields: [categoryId], references: [id])
  name            String
  purity          String   // e.g., "22K", "24K", "18K"
  weight          Float    // in grams
  description     String
  makingCharges   Float    // percentage or fixed amount
  images          String[] // URLs to S3/Cloud Storage
  
  wishlistedBy    Wishlist[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SavingsPlan {
  id              String   @id @default(uuid())
  name            String
  type            PlanType @default(AMOUNT)
  monthlyAmount   Float
  durationMonths  Int
  benefits        String
  terms           String
  
  userPlans       UserPlan[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserPlan {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  planId            String
  plan              SavingsPlan @relation(fields: [planId], references: [id])
  status            PlanStatus  @default(ACTIVE)
  accumulatedWeight Float       @default(0.0)
  startDate         DateTime    @default(now())
  nextDueDate       DateTime
  
  installments      Installment[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Installment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  userPlanId    String
  userPlan      UserPlan @relation(fields: [userPlanId], references: [id])
  amount        Float
  metalWeight   Float    @default(0.0)
  status        InstallmentStatus @default(PENDING)
  dueDate       DateTime
  paidAt        DateTime?
  transactionId String?  // Reference to payment gateway transaction
  ratePending   Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DigitalLocker {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  goldBalance         Float    @default(0.0) // In grams
  silverBalance       Float    @default(0.0) // In grams
  totalInvestedGold   Float    @default(0.0) // In INR
  totalInvestedSilver Float    @default(0.0) // In INR

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DigitalTransaction {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  type          TransactionType
  metalType     MetalType
  weight        Float           // In grams
  amount        Float           // Total amount paid/received
  status        PaymentStatus   @default(PENDING)
  transactionId String?         // Reference to payment gateway transaction
  ratePending   Boolean         @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Wishlist {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  jewelleryId   String
  jewellery     JewelleryItem @relation(fields: [jewelleryId], references: [id])

  createdAt     DateTime @default(now())
  @@unique([userId, jewelleryId])
}

model MetalRate {
  id          String   @id @default(uuid())
  goldRate    Float    // 24K Gold per gram (Base)
  silverRate  Float    // Pure Silver per gram
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   // e.g., 'RATE_UPDATE', 'PURCHASE_SUCCESS', 'REMINDER'
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
